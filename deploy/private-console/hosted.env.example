# Operator template only. Replace every placeholder; never commit real deployment values.
ACKIVAULT_ORIGIN=https://console.example.invalid
ACKIVAULT_PORT=4317
ACKIVAULT_ACCESS_ISSUER=https://replace-team.cloudflareaccess.com
ACKIVAULT_ACCESS_AUDIENCE=REPLACE_APPLICATION_AUDIENCE
