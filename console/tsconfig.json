{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"], "types": ["node"], "strict": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "noImplicitReturns": true,
    "rootDir": ".", "outDir": "dist", "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "browser/**/*.ts", "test/**/*.ts"]
}
